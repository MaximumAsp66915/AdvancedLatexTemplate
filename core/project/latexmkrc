# Build with XeLaTeX (fonts and Persian support need it):  latexmk main.tex
$pdf_mode = 5;                      # xelatex -> xdv -> pdf
$xelatex  = 'xelatex -interaction=nonstopmode -file-line-error -synctex=1 %O %S';
$bibtex_use = 1.5;                  # run BibTeX when there is a .bib file
@default_files = ('main.tex');
